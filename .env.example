# Google Flow MCP — Environment

# Option A (recommended): use persistent Chrome profile — run `npm run login` once, then leave this blank
GOOGLE_COOKIES=""

# Option B: paste your labs.google session cookies here as a fallback
# GOOGLE_COOKIES="__Secure-next-auth.session-token=...; email=..."

# Chrome settings
CHROME_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
CHROME_USER_DATA_DIR="~/.config/google-flow-mcp/profile"
HEADLESS="false"

# Where to save downloaded assets
LOCAL_STORAGE_ROOT="/Volumes/Xstorage/Media"

# Transport: stdio (for Codex/Claude/Antigravity) or http (for testing)
TRANSPORT="stdio"
PORT=3100
